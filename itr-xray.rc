#!/sbin/openrc-run

command="/usr/local/itr-xray/itr-xray"
command_background=true
pidfile="/run/itr-xray.pid"
description="itr-xray Service"
procname="itr-xray"
depend() {
    need net
}
start_pre(){
    cd /usr/local/itr-xray
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1 $(cat $pidfile)
  eend $?
}